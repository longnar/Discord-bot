# Discord Bot Token (lấy từ Discord Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=your_discord_bot_token_here

# Đặt true cho lần chạy đầu hoặc khi thêm/sửa Slash Commands; nên để false khi vận hành ổn định
SYNC_COMMANDS=true

# Turso Database cho hệ thống Elo (thay cho database.db)
TURSO_ELO_URL=libsql://isdvn-elo-yourorg.turso.io
TURSO_ELO_AUTH_TOKEN=your_turso_elo_auth_token

# Turso Database cho Wiki & Frame Data (thay cho wiki.db)
TURSO_WIKI_URL=libsql://isdvn-wiki-yourorg.turso.io
TURSO_WIKI_AUTH_TOKEN=your_turso_wiki_auth_token
